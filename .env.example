# Copy this file to ".env" and fill in your keys.
# Never commit your real .env file.

# --- Groq (free API — https://console.groq.com) ---
# Create a free account, then go to API Keys -> Create API Key. No card needed.
GROQ_API_KEY=gsk_your_key_here
# openai/gpt-oss-20b is fast, free-tier friendly, and Groq's current recommended default
# (llama-3.1-8b-instant was deprecated for free/developer accounts in Aug 2026).
# llama-3.3-70b-versatile is higher quality but rate-limited to ~10 requests/minute on the free tier.
GROQ_MODEL=openai/gpt-oss-20b

# --- LangSmith (free "Developer" plan — https://smith.langchain.com) ---
# Leave LANGSMITH_TRACING=false until you finish step 05; flipping it to true
# turns on tracing for every script that loads this file.
LANGSMITH_TRACING=false
LANGSMITH_API_KEY=lsv2_pt_your_key_here
LANGSMITH_PROJECT=langchain-learning
